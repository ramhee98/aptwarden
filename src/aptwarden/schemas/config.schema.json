{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ramhee98/aptwarden/schemas/config.schema.json",
  "title": "aptwarden configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hosts"
  ],
  "properties": {
    "state_dir": {
      "type": "string"
    },
    "cache_dir": {
      "type": "string"
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "keep_runs": {
      "type": "integer",
      "minimum": 1
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        "format": {
          "enum": [
            "auto",
            "json",
            "text"
          ]
        }
      }
    },
    "ssh": {
      "$ref": "#/$defs/ssh"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debian_tracker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "refresh_interval": {
              "$ref": "#/$defs/duration"
            },
            "max_age": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "osv": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "description": "signed-tags: newest signed tag (default). branch: follow a branch without verification",
              "enum": [
                "signed-tags",
                "branch"
              ]
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "tag_pattern": {
              "type": "string",
              "minLength": 1
            },
            "allowed_signers_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "refresh_interval": {
              "$ref": "#/$defs/duration"
            }
          }
        }
      }
    },
    "enrich": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cvss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "osv_url": {
              "type": "string"
            },
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "cache_ttl": {
              "$ref": "#/$defs/duration"
            },
            "negative_ttl": {
              "$ref": "#/$defs/duration"
            },
            "nvd": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                },
                "api_key_file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "budget": {
                  "$ref": "#/$defs/duration"
                }
              }
            }
          }
        },
        "kev": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "refresh_interval": {
              "$ref": "#/$defs/duration"
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_severity": {
          "$ref": "#/$defs/severity"
        },
        "show": {
          "enum": [
            "fixable",
            "all"
          ]
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "description": "Per-run summary: always, only when something changed, or never",
          "enum": [
            "always",
            "changes",
            "never"
          ]
        },
        "subject_prefix": {
          "type": "string"
        },
        "alert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_severity": {
              "$ref": "#/$defs/severity"
            },
            "kev": {
              "type": "boolean"
            },
            "host_errors": {
              "type": "boolean"
            },
            "remind_after": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "security": {
              "enum": [
                "starttls",
                "ssl",
                "none"
              ]
            },
            "tls_verify": {
              "type": "boolean"
            },
            "tls_server_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Name to verify the certificate against when host is an IP"
            },
            "username": {
              "type": [
                "string",
                "null"
              ]
            },
            "password_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "from": {
              "type": "string",
              "minLength": 3
            },
            "to": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 3
              }
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "host",
              "from",
              "to"
            ]
          }
        }
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": {
          "$ref": "#/$defs/duration"
        },
        "vmstate": {
          "type": "boolean"
        }
      }
    },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "node",
        "token_id",
        "token_file"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "node": {
          "type": "string"
        },
        "token_id": {
          "type": "string",
          "pattern": "^[^@!\\s]+@[^@!\\s]+![^@!\\s]+$"
        },
        "token_file": {
          "type": "string"
        },
        "tls_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9A-Fa-f]{2}:?){32}$"
        },
        "ca_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "task_timeout": {
          "type": "integer",
          "minimum": 10
        }
      }
    },
    "status_page": {
      "description": "Static HTML status page, rewritten after every report and patch run",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "description": "Output file (default: <state_dir>/www/index.html)",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "File mode, octal string",
          "type": "string",
          "pattern": "^0?[0-7]{3}$"
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "description": "Seconds as integer, or a number with unit s, m, h or d (e.g. 90s, 30m, 1h, 3d)",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+[smhd]$"
        }
      ]
    },
    "severity": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "identity_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_hosts_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "strict_host_key_checking": {
          "enum": [
            "yes",
            "accept-new"
          ]
        },
        "connect_timeout": {
          "type": "integer",
          "minimum": 1
        },
        "command_timeout": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "description": "Extra ssh -o options",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "helper": {
          "description": "Path of aptwarden-helper on the target host",
          "type": "string"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "ssh",
            "local"
          ]
        },
        "ssh": {
          "$ref": "#/$defs/ssh"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "enum": [
                "proxmox",
                "none"
              ]
            },
            "vmid": {
              "type": "integer",
              "minimum": 100
            },
            "type": {
              "enum": [
                "lxc",
                "qemu"
              ]
            },
            "node": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "provider": {
                "const": "proxmox"
              }
            }
          },
          "then": {
            "required": [
              "provider",
              "vmid",
              "type"
            ]
          }
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "healthchecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/healthcheck"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "description": "Allowed modes: report, dry-run (plan + simulation), patch",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "report",
              "dry-run",
              "patch"
            ]
          }
        },
        "auto_patch_severities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "unknown"
            ]
          }
        },
        "auto_patch_kev": {
          "description": "Also patch KEV-listed vulnerabilities of any severity",
          "type": "boolean"
        },
        "window": {
          "description": "Maintenance windows, e.g. 'Mon..Fri 02:00-04:00'; empty = any time",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restart": {
          "description": "needrestart: auto (restart services), list (report only), off",
          "enum": [
            "auto",
            "list",
            "off"
          ]
        },
        "reboot": {
          "enum": [
            "never",
            "if-required"
          ]
        },
        "rollback": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "allow_without_snapshot": {
          "type": "boolean"
        },
        "allow_extra_upgrades": {
          "description": "Allow upgrades of packages outside the plan pulled in as dependencies",
          "type": "boolean"
        },
        "allow_new_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grace": {
          "$ref": "#/$defs/duration"
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "interval": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "healthcheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "systemd"
          ],
          "properties": {
            "systemd": {
              "type": "string",
              "pattern": "^[A-Za-z0-9@._:-]+$"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "http"
          ],
          "properties": {
            "http": {
              "type": "string",
              "pattern": "^https?://"
            },
            "expect_status": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            },
            "contains": {
              "type": "string"
            },
            "verify_tls": {
              "type": "boolean"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "on_host": {
              "description": "Run the check on the target via SSH (as the unprivileged user) instead of from the central host",
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tcp"
          ],
          "properties": {
            "tcp": {
              "type": "string",
              "pattern": "^.+:[0-9]+$"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            },
            "on_host": {
              "description": "Run the check on the target via SSH (as the unprivileged user) instead of from the central host",
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
