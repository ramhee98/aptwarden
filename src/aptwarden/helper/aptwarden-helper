#!/bin/sh
# aptwarden-helper: the only program aptwarden runs as root on a target host.
#
# Install root-owned as /usr/local/lib/aptwarden/aptwarden-helper (mode 0755)
# and allow it, and nothing else, in /etc/sudoers.d/aptwarden. A sudoers rule
# on apt-get itself would be root for anyone who can pass options
# (-o APT::Update::Pre-Invoke::=/bin/sh). This script only accepts fixed
# subcommands and strictly validated "package=version" arguments. install
# first simulates the transaction itself and refuses it if apt would install
# anything that was not named with exactly that version, or remove anything.
set -eu
set -f  # no globbing of arguments

HELPER_VERSION=3

PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Test hook for aptwarden's own test suite. Never honoured as root, so it has
# no effect through sudo.
if [ "$(id -u)" != 0 ] && [ -n "${APTWARDEN_HELPER_TESTBIN:-}" ]; then
    PATH=$APTWARDEN_HELPER_TESTBIN:$PATH
fi
export PATH
export LC_ALL=C.UTF-8
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
# needrestart runs explicitly afterwards, with the host's configured mode.
export NEEDRESTART_SUSPEND=1
export UCF_FORCE_CONFFOLD=1
umask 022

# Exit status 2 means refused before apt ran, so nothing changed. aptwarden
# relies on this.
die() {
    echo "aptwarden-helper: $*" >&2
    exit 2
}

# --no-remove: apt fails instead of removing packages to resolve a conflict.
APT_OPTS="-q -y --only-upgrade --no-remove --no-install-recommends
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold
    -o DPkg::Lock::Timeout=300"

check_packages() {
    [ "$#" -gt 0 ] || die "no packages given"
    [ "$#" -le 500 ] || die "too many packages"
    for arg in "$@"; do
        case "$arg" in
            *[!a-zA-Z0-9+.:=~-]*) die "invalid characters in: $arg" ;;
            *=*=*) die "invalid package spec: $arg" ;;
            *=*) ;;
            *) die "expected package=version, got: $arg" ;;
        esac
        pkg=${arg%%=*}
        ver=${arg#*=}
        case "$pkg" in
            [a-z0-9]*) ;;
            *) die "invalid package name: $pkg" ;;
        esac
        case "$pkg" in
            *[!a-z0-9+.:-]*) die "invalid package name: $pkg" ;;
        esac
        case "$ver" in
            [0-9]*) ;;
            *) die "invalid version: $ver" ;;
        esac
    done
}

# The simulation on the central host may be outdated when install runs (the
# package lists can change in between), and --only-upgrade still installs new
# dependencies. So install simulates again and requires every "Inst" to be one
# of the named package=version pairs, and no "Remv" at all. Architecture
# qualifiers are ignored: apt omits them for the native architecture.
check_transaction() {
    allowed=" "
    for arg in "$@"; do
        pkg=${arg%%=*}
        allowed="$allowed${pkg%%:*}=${arg#*=} "
    done
    # shellcheck disable=SC2086
    sim=$(apt-get $APT_OPTS -s install -- "$@" 2>&1) || {
        printf '%s\n' "$sim" >&2
        die "simulation failed, nothing installed"
    }
    while IFS= read -r line; do
        case "$line" in
            "Remv "*) die "simulation would remove ${line#Remv }; nothing installed" ;;
            "Inst "*)
                # shellcheck disable=SC2086 # word splitting is intended, globbing is off
                check_inst $line
                ;;
        esac
    done <<EOF
$sim
EOF
}

# check_inst Inst NAME [OLD] (NEW ...
check_inst() {
    name=${2%%:*}
    case "${3:-}" in
        "["*) new=${4:-} ;;
        *) new=${3:-} ;;
    esac
    new=${new#(}
    case "$allowed" in
        *" $name=$new "*) ;;
        *) die "simulation would install $name $new, which was not requested; nothing installed" ;;
    esac
}

cmd=${1:-}
[ "$#" -gt 0 ] && shift

case "$cmd" in
    version)
        echo "aptwarden-helper $HELPER_VERSION"
        ;;
    update)
        [ "$#" -eq 0 ] || die "update takes no arguments"
        exec apt-get -q -o DPkg::Lock::Timeout=300 update
        ;;
    simulate)
        check_packages "$@"
        # shellcheck disable=SC2086 # word splitting of APT_OPTS is intended
        exec apt-get $APT_OPTS -s install -- "$@"
        ;;
    install)
        check_packages "$@"
        check_transaction "$@"
        # shellcheck disable=SC2086
        exec apt-get $APT_OPTS install -- "$@"
        ;;
    needrestart)
        [ "$#" -eq 1 ] || die "usage: needrestart list|restart"
        command -v needrestart >/dev/null 2>&1 || { echo "needrestart not installed" >&2; exit 3; }
        case "$1" in
            list) exec needrestart -r l -b ;;
            restart)
                # Batch mode (-b) only lists: needrestart skips the restart of
                # every service there, whatever -r says. So list, restart without
                # -b (its report goes to stderr), and list again. What is still
                # listed was deferred or refused (needrestart leaves e.g. dbus and
                # display managers alone) or did not come back with the new code.
                before=$(needrestart -r l -b) || {
                    echo "aptwarden-helper: needrestart -r l -b failed" >&2
                    exit 1
                }
                printf '%s\n' "$before"
                case "$before" in
                    *"NEEDRESTART-SVC: "*) ;;
                    *) exit 0 ;;
                esac
                # -l: only the library check; kernel and microcode are in $before
                needrestart -r a -l </dev/null >&2 ||
                    echo "aptwarden-helper: needrestart -r a exited $?" >&2
                after=$(needrestart -r l -b -l) || {
                    echo "aptwarden-helper: needrestart -r l -b failed after the restart" >&2
                    exit 1
                }
                while IFS= read -r line; do
                    case "$line" in
                        "NEEDRESTART-SVC: "*)
                            echo "APTWARDEN-PENDING: ${line#NEEDRESTART-SVC: }" ;;
                    esac
                done <<EOF
$after
EOF
                ;;
            *) die "usage: needrestart list|restart" ;;
        esac
        ;;
    reboot)
        [ "$#" -eq 0 ] || die "reboot takes no arguments"
        exec systemctl reboot
        ;;
    *)
        die "unknown command: ${cmd:-<none>} (version|update|simulate|install|needrestart|reboot)"
        ;;
esac
